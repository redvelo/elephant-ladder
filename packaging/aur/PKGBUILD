pkgname=elephant-ladder-git
pkgver=r0
pkgrel=1
pkgdesc="EPUB reader built on EPUB Stack and EPUB Navigator"
arch=(x86_64)
url="https://github.com/redvelo/elephant-ladder"
license=(unknown)
depends=(alsa-lib at-spi2-core cups gtk3 libpulse libxcomposite libxdamage libxkbcommon libxrandr mesa nss)
makedepends=(cmake git nodejs pnpm rust rust-wasm wasm-pack)
optdepends=('xdg-desktop-portal: save dialogs for annotation export')
provides=(elephant-ladder)
conflicts=(elephant-ladder)
options=(!lto !debug)
source=(
  "elephant-ladder::git+https://github.com/redvelo/elephant-ladder.git"
  "navigator::git+https://github.com/redvelo/epub-navigator.git"
  "stack::git+https://github.com/redvelo/epub-stack.git"
)
sha256sums=(SKIP SKIP SKIP)

pkgver() {
  cd elephant-ladder
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd navigator
  pnpm install --frozen-lockfile
  cd ../elephant-ladder
  pnpm install --frozen-lockfile
}

build() {
  cd elephant-ladder
  # The CEF runtime downloads its Chromium distribution during this build.
  node scripts/tauri-pinned.mjs build --no-bundle
}

package() {
  cd elephant-ladder
  local release=src-tauri/target/release
  local app=/usr/lib/elephant-ladder

  install -d "$pkgdir$app" "$pkgdir/usr/bin"
  install -m755 "$release/elephant-ladder" "$pkgdir$app/"
  install -m644 \
    "$release"/{libcef.so,libEGL.so,libGLESv2.so,libvk_swiftshader.so,libvulkan.so.1} \
    "$release"/{vk_swiftshader_icd.json,chrome_100_percent.pak,chrome_200_percent.pak} \
    "$release"/{resources.pak,icudtl.dat,v8_context_snapshot.bin} \
    "$pkgdir$app/"
  cp -r "$release/locales" "$pkgdir$app/"
  ln -s "$app/elephant-ladder" "$pkgdir/usr/bin/elephant-ladder"

  install -Dm644 packaging/linux/com.redvelo.ElephantLadder.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.redvelo.ElephantLadder.png"
}
