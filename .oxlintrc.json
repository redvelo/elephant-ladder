{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "react",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "promise",
    "node",
    "jsx-a11y",
    "react-perf",
    "vitest"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-compiler": "error",
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/no-misused-spread": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/unbound-method": "error",
    // Reviewed and kept off. consistent-return: every finding is a React effect guard clause
    // or an exhaustive switch the rule cannot model. no-unsafe-type-assertion: the remainder
    // is generic pass-throughs, trusted-boundary kernel decodes, union merges TypeScript will
    // not distribute, and worker globals the DOM lib cannot express.
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "eslint/no-underscore-dangle": "off",
    "react/react-in-jsx-scope": "off",
    "eslint/no-await-in-loop": "off",
    "vitest/require-mock-type-parameters": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "promise/no-multiple-resolved": "off",
    "vitest/valid-expect": "off",
    "unicorn/require-post-message-target-origin": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/no-autofocus": "off",
    "eslint/no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/prefer-set-has": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "vitest/no-conditional-expect": "off",
    "react/no-array-index-key": "off",
    "oxc/no-map-spread": "off",
    "promise/always-return": "off",
    "import/no-empty-named-blocks": "off",
    "react/iframe-missing-sandbox": "off",
    "react/jsx-no-constructed-context-values": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/error-message": "off",
    "unicorn/prefer-optional-catch-binding": "off",
    "typescript/no-extraneous-class": "off",
    "promise/no-callback-in-promise": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "vitest/require-to-throw-message": "off",
    "eslint/preserve-caught-error": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/interactive-supports-focus": "off"
  },
  "ignorePatterns": ["tests/fixtures/**/*-src/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "overrides": [
    {
      "files": ["tests/**", "scripts/**", "*.config.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      // Playwright fixtures declare their dependencies by destructuring, and its `use`
      // callback is not a React hook.
      "files": ["tests/native-browser/**"],
      "rules": {
        "eslint/no-empty-pattern": "off",
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
