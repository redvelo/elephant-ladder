---
source: crates/native-host/src/storage/migrations.rs
expression: schema(&migrated_from_zero())
---
index active_browser_origin_owner: CREATE UNIQUE INDEX active_browser_origin_owner ON browser_origin_allocations(publication_id) WHERE lifecycle_state = 'active'
index annotation_history: CREATE INDEX annotation_history ON annotations(publication_id, created)
index dictionary_installed_revision: CREATE UNIQUE INDEX dictionary_installed_revision ON dictionary_installations(pack_id) WHERE state = 'installed'
index import_reservation_expiration: CREATE INDEX import_reservation_expiration ON import_reservations(expires_at)
index publication_snapshot_owner: CREATE INDEX publication_snapshot_owner ON publication_snapshots(publication_id)
index reading_activity_day: CREATE INDEX reading_activity_day ON reading_activity(day)
index reflection_draft: CREATE UNIQUE INDEX reflection_draft ON reflections(publication_id) WHERE draft = 1
index reflection_history: CREATE INDEX reflection_history ON reflections(publication_id, created_at DESC)
table annotation_projections: CREATE TABLE annotation_projections ( publication_id TEXT PRIMARY KEY REFERENCES publications(publication_id) ON DELETE CASCADE, projection_revision INTEGER NOT NULL CHECK( projection_revision >= 1 AND projection_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table annotations: CREATE TABLE annotations ( annotation_id TEXT NOT NULL CHECK(length(annotation_id) BETWEEN 1 AND 128), publication_id TEXT NOT NULL REFERENCES publications(publication_id) ON DELETE CASCADE, record_order INTEGER NOT NULL CHECK(record_order >= 1), record_type TEXT NOT NULL CHECK( record_type IN ('highlight', 'note', 'bookmark') ), occurrence INTEGER NOT NULL CHECK(occurrence >= 0 AND occurrence <= 4294967295), target_json TEXT NOT NULL CHECK(length(target_json) <= 1048576), resource_hint TEXT NOT NULL CHECK(length(resource_hint) <= 16384), section_label TEXT, excerpt TEXT, text TEXT, label TEXT, creator_json TEXT CHECK(creator_json IS NULL OR json_valid(creator_json)), created TEXT NOT NULL, modified TEXT NOT NULL CHECK(modified >= created), PRIMARY KEY(publication_id, annotation_id), UNIQUE(publication_id, record_order), CHECK((record_type = 'note') = (text IS NOT NULL)), CHECK(excerpt IS NULL OR record_type IN ('highlight', 'note')), CHECK(label IS NULL OR record_type = 'bookmark') ) STRICT
table archive_blobs: CREATE TABLE archive_blobs ( blob_hash TEXT PRIMARY KEY CHECK(length(blob_hash) = 64), storage_name TEXT NOT NULL UNIQUE, size_bytes INTEGER NOT NULL CHECK(size_bytes >= 0), health_state TEXT NOT NULL CHECK( health_state IN ('available', 'missing', 'corrupt') ), lifecycle_state TEXT NOT NULL CHECK( lifecycle_state IN ('live', 'gc_pending', 'trashed') ), created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table blob_cleanup_operations: CREATE TABLE blob_cleanup_operations ( blob_hash TEXT PRIMARY KEY REFERENCES archive_blobs(blob_hash) ON DELETE CASCADE, phase TEXT NOT NULL CHECK(phase IN ('pending', 'trashed')), attempts INTEGER NOT NULL DEFAULT 0 CHECK(attempts >= 0), next_retry_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), last_error TEXT, updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table browser_origin_allocations: CREATE TABLE browser_origin_allocations ( origin_id TEXT PRIMARY KEY CHECK( length(origin_id) = 32 AND origin_id NOT GLOB '*[^0-9a-f]*' ), publication_id TEXT REFERENCES publications(publication_id) ON DELETE SET NULL, lifecycle_state TEXT NOT NULL CHECK( lifecycle_state IN ('active', 'retired', 'purge_pending', 'purged') ), created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), retired_at TEXT, purge_attempts INTEGER NOT NULL DEFAULT 0 CHECK(purge_attempts >= 0), last_purge_error TEXT, last_purge_report_json TEXT, CHECK(lifecycle_state != 'active' OR publication_id IS NOT NULL), CHECK((lifecycle_state = 'active') = (retired_at IS NULL)) ) STRICT
table deletion_operations: CREATE TABLE deletion_operations ( publication_id TEXT PRIMARY KEY REFERENCES publications(publication_id) ON DELETE CASCADE, phase TEXT NOT NULL CHECK(phase IN ('marked', 'detached')), attempts INTEGER NOT NULL DEFAULT 0 CHECK(attempts >= 0), next_retry_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), last_error TEXT, detached_imported_blob_hash TEXT CHECK( detached_imported_blob_hash IS NULL OR length(detached_imported_blob_hash) = 64 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table dictionary_installations: CREATE TABLE dictionary_installations ( pack_id TEXT NOT NULL CHECK(length(pack_id) BETWEEN 1 AND 64), pack_revision TEXT NOT NULL CHECK(length(pack_revision) = 64), pack_type TEXT NOT NULL CHECK(pack_type IN ('corpus', 'audio')), corpus_language TEXT NOT NULL CHECK(length(corpus_language) BETWEEN 1 AND 35), manifest_sha256 TEXT NOT NULL CHECK(length(manifest_sha256) = 64), state TEXT NOT NULL CHECK(state IN ('installed', 'deleting')), installed_bytes INTEGER NOT NULL CHECK(installed_bytes >= 0), PRIMARY KEY (pack_id, pack_revision) ) STRICT
table dictionary_operations: CREATE TABLE dictionary_operations ( operation_id TEXT PRIMARY KEY CHECK(length(operation_id) = 32), operation_type TEXT NOT NULL CHECK(operation_type IN ('install', 'delete')), corpus_language TEXT NOT NULL CHECK(length(corpus_language) BETWEEN 1 AND 35), audio TEXT NOT NULL CHECK(audio IN ('streamed', 'stored')), catalog_revision TEXT, phase TEXT NOT NULL CHECK(phase IN ( 'catalog', 'preflight', 'downloading', 'verifying', 'installing', 'completed', 'cancelled', 'failed', 'interrupted' )), bytes_completed INTEGER NOT NULL CHECK(bytes_completed >= 0), bytes_total INTEGER NOT NULL CHECK(bytes_total >= 0), started_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), failure TEXT ) STRICT
table dictionary_views: CREATE TABLE dictionary_views ( view_id TEXT PRIMARY KEY CHECK(length(view_id) BETWEEN 1 AND 64), pack_id TEXT NOT NULL CHECK(length(pack_id) BETWEEN 1 AND 64), view_type TEXT NOT NULL CHECK(view_type IN ('monolingual', 'bilingual')), target_language TEXT CHECK( target_language IS NULL OR length(target_language) BETWEEN 1 AND 35 ), enabled INTEGER NOT NULL CHECK(enabled IN (0, 1)), display_order INTEGER NOT NULL UNIQUE CHECK(display_order >= 0), CHECK((view_type = 'bilingual') = (target_language IS NOT NULL)) ) STRICT
table import_reservations: CREATE TABLE import_reservations ( reservation_id TEXT PRIMARY KEY CHECK( length(reservation_id) = 32 AND reservation_id NOT GLOB '*[^0-9a-f]*' ), staging_name TEXT NOT NULL UNIQUE CHECK( staging_name = reservation_id || '.part' ), reserved_bytes INTEGER NOT NULL CHECK(reserved_bytes > 0), blob_hash TEXT CHECK( blob_hash IS NULL OR ( length(blob_hash) = 64 AND blob_hash NOT GLOB '*[^0-9a-f]*' ) ), created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), expires_at TEXT NOT NULL CHECK(expires_at > created_at) ) STRICT
table installation_origin_config: CREATE TABLE installation_origin_config ( singleton_key INTEGER PRIMARY KEY CHECK(singleton_key = 1), scheme_version INTEGER NOT NULL CHECK(scheme_version = 1), foreground_port INTEGER NOT NULL CHECK(foreground_port BETWEEN 1 AND 65535), reader_port INTEGER CHECK(reader_port IS NULL OR reader_port BETWEEN 1 AND 65535), created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table media_overlay_sidecars: CREATE TABLE media_overlay_sidecars ( snapshot_id TEXT NOT NULL REFERENCES publication_snapshots(snapshot_id) ON DELETE CASCADE, canonical_path TEXT NOT NULL, storage_name TEXT NOT NULL CHECK(length(storage_name) = 64), length_bytes INTEGER NOT NULL CHECK(length_bytes >= 0), media_type TEXT, created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), PRIMARY KEY (snapshot_id, canonical_path) ) STRICT
table media_overlay_timeline_files: CREATE TABLE media_overlay_timeline_files ( snapshot_id TEXT NOT NULL REFERENCES publication_snapshots(snapshot_id) ON DELETE CASCADE, overlay_index INTEGER NOT NULL CHECK(overlay_index >= 0), storage_name TEXT NOT NULL CHECK(length(storage_name) = 64), length_bytes INTEGER NOT NULL CHECK(length_bytes >= 0), PRIMARY KEY (snapshot_id, overlay_index) ) STRICT
table media_sidecar_transcodes: CREATE TABLE media_sidecar_transcodes ( source_hash TEXT NOT NULL CHECK(length(source_hash) = 64), derivation TEXT NOT NULL, storage_name TEXT NOT NULL CHECK(length(storage_name) = 64), length_bytes INTEGER NOT NULL CHECK(length_bytes >= 0), PRIMARY KEY (source_hash, derivation) ) STRICT
table publication_policy_defaults: CREATE TABLE publication_policy_defaults ( singleton_key INTEGER PRIMARY KEY CHECK(singleton_key = 1), active_content TEXT NOT NULL CHECK( active_content IN ('automatic', 'ask', 'disabled') ), remote_resources TEXT NOT NULL CHECK( remote_resources IN ('allowed', 'ask', 'blocked') ), policy_revision INTEGER NOT NULL CHECK( policy_revision >= 1 AND policy_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table publication_policy_overrides: CREATE TABLE publication_policy_overrides ( publication_id TEXT PRIMARY KEY REFERENCES publications(publication_id) ON DELETE CASCADE, active_content TEXT CHECK( active_content IS NULL OR active_content IN ('enabled', 'disabled') ), remote_resources TEXT CHECK( remote_resources IS NULL OR remote_resources IN ('allowed', 'blocked') ), policy_revision INTEGER NOT NULL CHECK( policy_revision >= 1 AND policy_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table publication_reader_preferences: CREATE TABLE publication_reader_preferences ( publication_id TEXT PRIMARY KEY REFERENCES publications(publication_id) ON DELETE CASCADE, preferences_json TEXT NOT NULL CHECK(length(preferences_json) <= 1024), preferences_revision INTEGER NOT NULL CHECK( preferences_revision >= 1 AND preferences_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table publication_snapshots: CREATE TABLE publication_snapshots ( snapshot_id TEXT PRIMARY KEY CHECK(length(snapshot_id) = 32), publication_id TEXT NOT NULL REFERENCES publications(publication_id), blob_hash TEXT NOT NULL REFERENCES archive_blobs(blob_hash), reading_revision TEXT NOT NULL CHECK(length(reading_revision) BETWEEN 1 AND 64), facts_json TEXT NOT NULL CHECK(length(facts_json) <= 25165824), responses_json TEXT NOT NULL CHECK(length(responses_json) <= 25165824), active_content_relevance TEXT NOT NULL DEFAULT 'unknown' CHECK( active_content_relevance IN ('detected', 'not-detected', 'unknown') ), remote_resources_relevance TEXT NOT NULL DEFAULT 'unknown' CHECK( remote_resources_relevance IN ('detected', 'not-detected', 'unknown') ), media_overlay_json TEXT CHECK( media_overlay_json IS NULL OR length(media_overlay_json) <= 25165824 ), media_overlay_capability_json TEXT CHECK( media_overlay_capability_json IS NULL OR length(media_overlay_capability_json) <= 25165824 ), cover_hash TEXT CHECK(cover_hash IS NULL OR length(cover_hash) = 64), cover_size_bytes INTEGER CHECK(cover_size_bytes IS NULL OR cover_size_bytes >= 0), cover_mime TEXT CHECK(cover_mime IS NULL OR cover_mime IN ( 'image/gif', 'image/jpeg', 'image/png', 'image/svg+xml', 'image/webp', 'image/avif', 'image/jxl' )), created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), revoked_at TEXT ) STRICT
table publications: CREATE TABLE publications ( publication_id TEXT PRIMARY KEY CHECK(length(publication_id) = 32), imported_blob_hash TEXT UNIQUE REFERENCES archive_blobs(blob_hash), current_snapshot_id TEXT, title_summary TEXT NOT NULL, title_direction_summary TEXT, creators_summary TEXT NOT NULL DEFAULT '[]', creator_directions_summary TEXT NOT NULL DEFAULT '[]', language_summary TEXT, reading_direction_summary TEXT, imported_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), deletion_state TEXT NOT NULL CHECK( deletion_state IN ('live', 'deleting', 'delete_failed') ), FOREIGN KEY(current_snapshot_id) REFERENCES publication_snapshots(snapshot_id) ) STRICT
table reader_preferences: CREATE TABLE reader_preferences ( singleton_key INTEGER PRIMARY KEY CHECK(singleton_key = 1), preferences_json TEXT NOT NULL CHECK(length(preferences_json) <= 4096), preferences_revision INTEGER NOT NULL CHECK( preferences_revision >= 1 AND preferences_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table reading_activity: CREATE TABLE reading_activity ( recording_id TEXT NOT NULL, day TEXT NOT NULL, milliseconds INTEGER NOT NULL CHECK(milliseconds >= 0), pages INTEGER NOT NULL CHECK(pages >= 0), PRIMARY KEY(recording_id, day) ) STRICT
table reading_positions: CREATE TABLE reading_positions ( publication_id TEXT PRIMARY KEY REFERENCES publications(publication_id) ON DELETE CASCADE, position_json TEXT NOT NULL, summary_json TEXT, position_revision INTEGER NOT NULL CHECK( position_revision >= 1 AND position_revision <= 4294967295 ), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
table reflections: CREATE TABLE reflections ( id TEXT PRIMARY KEY, publication_id TEXT NOT NULL REFERENCES publications(publication_id) ON DELETE CASCADE, text TEXT NOT NULL DEFAULT '', prompt INTEGER NOT NULL CHECK(prompt BETWEEN 0 AND 4), draft INTEGER NOT NULL CHECK(draft IN (0, 1)), context_json TEXT, position_json TEXT, created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ) STRICT
