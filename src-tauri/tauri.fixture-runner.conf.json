{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elephant Ladder Fixture Runner",
  "version": "0.1.0",
  "identifier": "com.redvelo.elephant-ladder.fixture-runner",
  "build": {
    "beforeBuildCommand": "pnpm build:fixture-runner",
    "frontendDist": "../dist-fixture-runner"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null, "capabilities": [] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
